# ===== pgAdmin =====
PGADMIN_DEFAULT_EMAIL=modified
PGADMIN_DEFAULT_PASSWORD=modified
PGADMIN_DEFAULT_PORT=modified

# ===== Strapi app =====
HOSTNAME=modified
APP_PORT=modified
APP_KEYS=modified
JWT_SECRET=modified
ADMIN_JWT_SECRET=modified
ADMIN_SECRET=modified
API_TOKEN_SALT=modified
TRANSFER_TOKEN_SALT=modified

# ===== Reset-token logging (dev only; keep false in production) =====
LOG_RESET_TOKEN=modified

# ===== SMTP (optional) =====
SMTP_HOST=modified
SMTP_PORT=modified
SMTP_USERNAME=modified
SMTP_PASSWORD=modified
SMTP_SECURE=false
EMAIL_FROM=modified
EMAIL_REPLY_TO=modified

# ===== Admin test account (api.http) =====
ADMIN_EMAIL=modified
ADMIN_PASSWORD=modified
ADMIN_NEW_PASSWORD=modified
# ADMIN_JWT: อย่าเก็บถาวร หลัง login สำเร็จให้เอา token ใส่ชั่วคราวเพื่อทดสอบ 1.4 แล้วลบออก
ADMIN_JWT=modified
# ===== User test account (api.http) =====
USER_EMAIL=modified
USER_PASSWORD=modified
USER_NEW_PASSWORD=modified
# USER_RESET_CODE / ADMIN_RESET_TOKEN: เป็น single-use เก็บชั่วคราวเท่านั้น อ่านค่าจาก docker logs 69-s2-app --tail 50 (บรรทัด [reset-token]) แล้วลบออกหลังใช้
USER_RESET_CODE=modified
ADMIN_RESET_TOKEN=modified
# USER_JWT: อย่าเก็บถาวร หลัง login สำเร็จให้เอา token ใส่ชั่วคราวเพื่อทดสอบ 2.4 แล้วลบออก
USER_JWT=modified

# Student Data
# STUDENT_MOBILE / STUDENT_CARDID เป็น unique -> ค่านี้ถูกใช้ไปแล้วห้ามซ้ำ ให้เปลี่ยนเป็นค่าใหม่ถ้าจะรัน 3.1.1 ซ้ำ
STUDENT_NAME=modified
STUDENT_MOBILE=modified
STUDENT_CARDID=modified
STUDENT_NAME_UPDATE=modified

# Subject Data
# SUBJECT_TITLE เป็น unique -> ค่านี้ถูกใช้ไปแล้วห้ามซ้ำ ให้เปลี่ยนเป็นค่าใหม่ถ้าจะรัน 3.2.1 ซ้ำ
SUBJECT_TITLE=modified
SUBJECT_TITLE_UPDATE=modified

# Teacher Data
