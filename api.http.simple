# REST

## Variables
@hostname = {{$dotenv HOSTNAME}}
@port = {{$dotenv APP_PORT}}
@admin_email = {{$dotenv ADMIN_EMAIL}}
@admin_password = {{$dotenv ADMIN_PASSWORD}}
@admin_new_password = {{$dotenv ADMIN_NEW_PASSWORD}}
@admin_reset_token = {{$dotenv ADMIN_RESET_TOKEN}}
# ADMIN_JWT: อย่าเก็บถาวร หลัง login สำเร็จให้เอา token จาก response ใส่ชั่วคราวเพื่อทดสอบ 1.4 แล้วลบออก
@admin_jwt = {{$dotenv ADMIN_JWT}}
@user_email = {{$dotenv USER_EMAIL}}
@user_password = {{$dotenv USER_PASSWORD}}
@user_new_password = {{$dotenv USER_NEW_PASSWORD}}
@user_reset_code = {{$dotenv USER_RESET_CODE}}
# USER_JWT: อย่าเก็บถาวร หลัง login สำเร็จให้เอา token จาก response ใส่ชั่วคราวเพื่อทดสอบ 2.4 แล้วลบออก
@user_jwt = {{$dotenv USER_JWT}}
@student_id = {{$dotenv STUDENT_ID}}
@student_firstname = {{$dotenv STUDENT_FIRSTNAME}}
@student_lastname = {{$dotenv STUDENT_LASTNAME}}
@student_email = {{$dotenv STUDENT_EMAIL}}
@student_code = {{$dotenv STUDENT_CODE}}
@subject_id = {{$dotenv SUBJECT_ID}}
@subject_name = {{$dotenv SUBJECT_NAME}}
@subject_code = {{$dotenv SUBJECT_CODE}}
@subject_credits = {{$dotenv SUBJECT_CREDITS}}
@subject_description = {{$dotenv SUBJECT_DESCRIPTION}}
@teacher_id = {{$dotenv TEACHER_ID}}
@teacher_firstname = {{$dotenv TEACHER_FIRSTNAME}}
@teacher_lastname = {{$dotenv TEACHER_LASTNAME}}
@teacher_email = {{$dotenv TEACHER_EMAIL}}
@teacher_department = {{$dotenv TEACHER_DEPARTMENT}}

## 1.Admin
### 1.1 Login
POST http://{{hostname}}:{{port}}/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "rememberMe": false
}

### 1.2 Register (admin) one time for first time to create admin account
POST http://{{hostname}}:{{port}}/admin/register-admin
Content-Type: application/json

{
    "firstname": "Palapon",
    "lastname": "Somsup",
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
}

### 1.3 Forgot Password
# Reset token is NOT emailed. After this fires, read the token from the app terminal:
#   docker logs 69-s2-app --tail 50   (line: [reset-token] /admin/forgot-password -> ...)
# Copy that value into ADMIN_RESET_TOKEN in .env, then run 1.3.1 below.
POST http://{{hostname}}:{{port}}/admin/forgot-password
Content-Type: application/json

{
    "email": "{{admin_email}}"
}

### 1.3.1 Reset Password
POST http://{{hostname}}:{{port}}/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "{{admin_reset_token}}",
    "password": "{{admin_new_password}}"
}

### 1.4 Profile
GET http://{{hostname}}:{{port}}/admin/users/me
Authorization: Bearer {{admin_jwt}}

## 2.User
### 2.1 Login
POST http://{{hostname}}:{{port}}/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.2 Register
POST http://{{hostname}}:{{port}}/api/auth/local/register
Content-Type: application/json

{
    "username": "Palapon",
    "email": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.3 Forgot Password
# Reset code is NOT emailed. After this fires, read the code from the app terminal:
#   docker logs 69-s2-app --tail 50   (line: [reset-token] /api/auth/forgot-password -> ...)
# Copy that value into USER_RESET_CODE in .env, then run 2.3.1 below.
POST http://{{hostname}}:{{port}}/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{user_email}}"
}

### 2.3.1 Reset Password
POST http://{{hostname}}:{{port}}/api/auth/reset-password
Content-Type: application/json

{
    "code": "{{user_reset_code}}",
    "password": "{{user_new_password}}",
    "passwordConfirmation": "{{user_new_password}}"
}

### 2.4 Profile
GET http://{{hostname}}:{{port}}/api/users/me
Authorization: Bearer {{user_jwt}}

## 3.Content
# Prerequisites before running section 3:
#   1. Content-Type Builder -> create Collection Type with API ID: student, subject, teacher
#   2. Add the fields used in the payloads below (see .env comments for the field list)
#   3. Settings -> Users & Permissions -> Public/Authenticated role -> enable
#      create/find/findOne/update for student, subject, teacher
#   4. Login 2.1 first, put the returned jwt in USER_JWT in .env
#      (admin jwt does NOT work on /api/* content endpoints)
#   5. Run 3.x.1 Create first, then copy the returned data.id into
#      STUDENT_ID / SUBJECT_ID / TEACHER_ID in .env before running 3.x.3 / 3.x.4

### 3.1 Student
#### 3.1.1 Create
POST http://{{hostname}}:{{port}}/api/students
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "firstname": "{{student_firstname}}",
        "lastname": "{{student_lastname}}",
        "email": "{{student_email}}",
        "code": "{{student_code}}"
    }
}

#### 3.1.2 List All
GET http://{{hostname}}:{{port}}/api/students?pagination[pageSize]=25&sort=code:asc
Authorization: Bearer {{user_jwt}}

#### 3.1.3 List with ID
GET http://{{hostname}}:{{port}}/api/students/{{student_id}}
Authorization: Bearer {{user_jwt}}

#### 3.1.4 Update
PUT http://{{hostname}}:{{port}}/api/students/{{student_id}}
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "firstname": "{{student_firstname}}",
        "lastname": "{{student_lastname}}",
        "email": "{{student_email}}",
        "code": "{{student_code}}"
    }
}

### 3.2 Subject
#### 3.2.1 Create
POST http://{{hostname}}:{{port}}/api/subjects
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "name": "{{subject_name}}",
        "code": "{{subject_code}}",
        "credits": "{{subject_credits}}",
        "description": "{{subject_description}}"
    }
}

#### 3.2.2 List All
GET http://{{hostname}}:{{port}}/api/subjects?pagination[pageSize]=25&sort=code:asc
Authorization: Bearer {{user_jwt}}

#### 3.2.3 List with ID
GET http://{{hostname}}:{{port}}/api/subjects/{{subject_id}}
Authorization: Bearer {{user_jwt}}

#### 3.2.4 Update
PUT http://{{hostname}}:{{port}}/api/subjects/{{subject_id}}
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "name": "{{subject_name}}",
        "code": "{{subject_code}}",
        "credits": "{{subject_credits}}",
        "description": "{{subject_description}}"
    }
}

### 3.3 Teacher
#### 3.3.1 Create
POST http://{{hostname}}:{{port}}/api/teachers
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "firstname": "{{teacher_firstname}}",
        "lastname": "{{teacher_lastname}}",
        "email": "{{teacher_email}}",
        "department": "{{teacher_department}}"
    }
}

#### 3.3.2 List All
GET http://{{hostname}}:{{port}}/api/teachers?pagination[pageSize]=25&sort=lastname:asc
Authorization: Bearer {{user_jwt}}

#### 3.3.3 List with ID
GET http://{{hostname}}:{{port}}/api/teachers/{{teacher_id}}
Authorization: Bearer {{user_jwt}}

#### 3.3.4 Update
PUT http://{{hostname}}:{{port}}/api/teachers/{{teacher_id}}
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "firstname": "{{teacher_firstname}}",
        "lastname": "{{teacher_lastname}}",
        "email": "{{teacher_email}}",
        "department": "{{teacher_department}}"
    }
}
