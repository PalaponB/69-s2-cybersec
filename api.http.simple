# REST

## Variables
@hostname = {{$dotenv HOSTNAME}}
@port = {{$dotenv APP_PORT}}
@admin_email = {{$dotenv ADMIN_EMAIL}}
@admin_password = {{$dotenv ADMIN_PASSWORD}}
@admin_new_password = {{$dotenv ADMIN_NEW_PASSWORD}}
@admin_reset_token = {{$dotenv ADMIN_RESET_TOKEN}}
# ADMIN_JWT: อย่าเก็บถาวร หลัง login สำเร็จให้เอา token จาก response ใส่ชั่วคราวเพื่อทดสอบ 1.4 แล้วลบออก
@admin_jwt = {{$dotenv ADMIN_JWT}}
@user_email = {{$dotenv USER_EMAIL}}
@user_password = {{$dotenv USER_PASSWORD}}
@user_new_password = {{$dotenv USER_NEW_PASSWORD}}
@user_reset_code = {{$dotenv USER_RESET_CODE}}
# USER_JWT: อย่าเก็บถาวร หลัง login สำเร็จให้เอา token จาก response ใส่ชั่วคราวเพื่อทดสอบ 2.4 และ section 3 แล้วลบออก
@user_jwt = {{$dotenv USER_JWT}}
@student_name = {{$dotenv STUDENT_NAME}}
@student_mobile = {{$dotenv STUDENT_MOBILE}}
@student_cardid = {{$dotenv STUDENT_CARDID}}
@student_name_update = {{$dotenv STUDENT_NAME_UPDATE}}

@subject_title = {{$dotenv SUBJECT_TITLE}}
@subject_title_update = {{$dotenv SUBJECT_TITLE_UPDATE}}

@teacher_name = {{$dotenv TEACHER_NAME}}
@teacher_name_update = {{$dotenv TEACHER_NAME_UPDATE}}

## 1.Admin
### 1.1 Login
POST http://{{hostname}}:{{port}}/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "rememberMe": false
}

### 1.2 Register (admin) one time for first time to create admin account
POST http://{{hostname}}:{{port}}/admin/register-admin
Content-Type: application/json

{
    "firstname": "Palapon",
    "lastname": "Somsup",
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
}

### 1.3 Forgot Password
# Reset token is NOT emailed. After this fires, read the token from the app terminal:
#   docker logs 69-s2-app --tail 50   (line: [reset-token] /admin/forgot-password -> ...)
# Copy that value into ADMIN_RESET_TOKEN in .env, then run 1.3.1 below.
POST http://{{hostname}}:{{port}}/admin/forgot-password
Content-Type: application/json

{
    "email": "{{admin_email}}"
}

### 1.3.1 Reset Password
POST http://{{hostname}}:{{port}}/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "{{admin_reset_token}}",
    "password": "{{admin_new_password}}"
}

### 1.4 Profile
GET http://{{hostname}}:{{port}}/admin/users/me
Authorization: Bearer {{admin_jwt}}

## 2.User
### 2.1 Login
POST http://{{hostname}}:{{port}}/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.2 Register
POST http://{{hostname}}:{{port}}/api/auth/local/register
Content-Type: application/json

{
    "username": "Palapon",
    "email": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.3 Forgot Password
# Reset code is NOT emailed. After this fires, read the code from the app terminal:
#   docker logs 69-s2-app --tail 50   (line: [reset-token] /api/auth/forgot-password -> ...)
# Copy that value into USER_RESET_CODE in .env, then run 2.3.1 below.
POST http://{{hostname}}:{{port}}/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{user_email}}"
}

### 2.3.1 Reset Password
POST http://{{hostname}}:{{port}}/api/auth/reset-password
Content-Type: application/json

{
    "code": "{{user_reset_code}}",
    "password": "{{user_new_password}}",
    "passwordConfirmation": "{{user_new_password}}"
}

### 2.4 Profile
GET http://{{hostname}}:{{port}}/api/users/me
Authorization: Bearer {{user_jwt}}

## 3. Content section
# Prerequisites before running section 3:
#   1. USER_JWT is intentionally empty in .env. Run 2.1 Login first, then copy the
#      jwt from the response into USER_JWT in .env, otherwise every request here
#      returns 403. (Admin jwt does NOT work on /api/* content endpoints.)
#   2. Settings -> Users & Permissions -> Authenticated role must have
#      create/find/findOne/update enabled for student, subject and teacher.
#   3. Fields used below (Content-Type Builder):
#      student -> name (required), mobile (required, unique, exactly 10 chars),
#                 cardId (required, unique, exactly 13 chars)
#      subject -> name (required, unique)
#      teacher -> name (required)
#   4. Run 3.x.1 Create before 3.x.3 / 3.x.4. mobile, cardId and subject name are
#      unique, so re-running 3.1.1 / 3.2.1 with a value that already exists in the
#      database returns 400. Put a new value in .env to run them again.
#   5. 3.x.3 / 3.x.4 address id 1, which is the record created by 3.x.1 on a fresh
#      database. After deleting that record, change the id in the URL.

### 3.1 Student
#### 3.1.1 Create
POST http://{{hostname}}:{{port}}/api/students
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "name": "{{student_name}}",
        "mobile": "{{student_mobile}}",
        "cardId": "{{student_cardid}}"
    }
}

#### 3.1.2 List All
GET http://{{hostname}}:{{port}}/api/students
Authorization: Bearer {{user_jwt}}

#### 3.1.3 List with ID
GET http://{{hostname}}:{{port}}/api/students/1
Authorization: Bearer {{user_jwt}}

#### 3.1.4 Update
PUT http://{{hostname}}:{{port}}/api/students/1
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "name": "{{student_name_update}}"
    }
}

### 3.2 Subject
#### 3.2.1 Create
POST http://{{hostname}}:{{port}}/api/subjects
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "name": "{{subject_title}}"
    }
}

#### 3.2.2 List All
GET http://{{hostname}}:{{port}}/api/subjects
Authorization: Bearer {{user_jwt}}

#### 3.2.3 List with ID
GET http://{{hostname}}:{{port}}/api/subjects/1
Authorization: Bearer {{user_jwt}}

#### 3.2.4 Update
PUT http://{{hostname}}:{{port}}/api/subjects/1
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "name": "{{subject_title_update}}"
    }
}

### 3.3 Teacher
#### 3.3.1 Create
POST http://{{hostname}}:{{port}}/api/teachers
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "name": "{{teacher_name}}"
    }
}

#### 3.3.2 List All
GET http://{{hostname}}:{{port}}/api/teachers
Authorization: Bearer {{user_jwt}}

#### 3.3.3 List with ID
GET http://{{hostname}}:{{port}}/api/teachers/1
Authorization: Bearer {{user_jwt}}

#### 3.3.4 Update
PUT http://{{hostname}}:{{port}}/api/teachers/1
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "name": "{{teacher_name_update}}"
    }
}
